# Copy this file to android/keystore.properties for local release signing.
# Do not commit android/keystore.properties or the .jks/.keystore file.
#
# Recommended location:
# storeFile=../release/halindosa-release.jks
#
# Android Studio can also generate this file through:
# Build > Generate Signed Bundle / APK > Android App Bundle > Create new...

storeFile=../release/halindosa-release.jks
storePassword=CHANGE_ME
keyAlias=halindosa
keyPassword=CHANGE_ME
