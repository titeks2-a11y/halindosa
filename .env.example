NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_AUTH_REDIRECT_URL=
NEXT_PUBLIC_APP_SCHEME=halindosa
NEXT_PUBLIC_APP_NAME=할인도사
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SUPPORT_EMAIL=support@halindosa.com

# Data provider mode supported by the app runtime: mock | staging | production | hybrid
# Source keys such as naver_shopping and partner_feed appear inside normalized deal records,
# but DEAL_DATA_MODE itself must stay one of the four runtime modes above.
DEAL_DATA_MODE=hybrid
DEAL_PROVIDER=hybrid
DEAL_LIVE_KEYWORDS=특가 할인,오늘만 특가,쿠폰 할인

# Naver Shopping Search Open API. Leave empty to use mock fallback locally.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional comma-separated JSON feeds returning Deal[] or { deals: Deal[] }.
DEAL_FEED_URLS=

# Optional production partner/official JSON feeds returning Deal[] or { deals: Deal[] }.
# Used only when DEAL_DATA_MODE=production or hybrid. Keep API secrets server-side.
DEAL_PRODUCTION_FEED_URLS=
DEAL_PARTNER_FEED_URLS=

# Optional RSS feeds for discount news and community hot-deal signals.
# If DEAL_NEWS_RSS_URLS is empty, the app uses a small Google News RSS keyword set.
DEAL_NEWS_RSS_URLS=
DEAL_COMMUNITY_RSS_URLS=

# Ppomppu/community collection should use an allowed RSS/API/proxy feed, not raw HTML scraping.
PPOMPPU_HOTDEAL_ENABLE=false
PPOMPPU_HOTDEAL_RSS_URL=

# Supabase connection values for the commercial data layer.
# Required to enable real email/social signup/login in /login, /signup, and /mypage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional affiliate/analytics settings.
AFFILIATE_SUB_ID=halindosa-local
# Optional affiliate redirect templates. Replace placeholders after partner approval.
# Supported placeholders: {url}, {encodedUrl}, {dealId}, {mall}, {campaign}, {subId}, {title}
DEFAULT_AFFILIATE_URL_TEMPLATE=
COUPANG_PARTNERS_URL_TEMPLATE=
# Example JSON: {"쿠팡":"https://your-affiliate.example/redirect?url={encodedUrl}&subid={subId}&campaign={campaign}"}
AFFILIATE_URL_TEMPLATES=
TRACKING_SALT=replace-with-random-secret
ADMIN_EXPORT_TOKEN=replace-before-production
