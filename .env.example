NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_AUTH_REDIRECT_URL=
NEXT_PUBLIC_APP_SCHEME=halindosa
NEXT_PUBLIC_APP_NAME=할인도사
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SUPPORT_EMAIL=support@halindosa.com

# Data provider mode supported by the app runtime: mock | staging | production | hybrid
# Source keys such as naver_shopping and partner_feed appear inside normalized deal records,
# but DEAL_DATA_MODE itself must stay one of the four runtime modes above.
DEAL_DATA_MODE=hybrid
DEAL_PROVIDER=hybrid
DEAL_LIVE_KEYWORDS=특가 할인,오늘만 특가,쿠폰 할인

# Naver Shopping Search Open API. Leave empty to use mock fallback locally.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional official/partner commerce API keys. Leave empty locally; providers fall back safely.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
ELEVENST_API_KEY=

# Optional provider-specific approved JSON feeds. Each feed should return Deal[] or { deals/items: Deal[] }.
# These are preferred over scraping and are consumed only by refresh/deal provider flows.
COUPANG_PARTNER_FEED_URLS=
NAVER_PARTNER_FEED_URLS=
ELEVENST_PARTNER_FEED_URLS=
DEAL_EVENT_FEED_URLS=
DEAL_REFRESH_LIVE_PROBE=false
DEAL_LINK_LIVE_PROBE=false
DEAL_LINK_LIVE_STRICT=false
DEAL_LINK_BODY_PROBE=false
DEAL_LINK_TIMEOUT_MS=3500

# Optional comma-separated JSON feeds returning Deal[] or { deals: Deal[] }.
DEAL_FEED_URLS=

# Optional production partner/official JSON feeds returning Deal[] or { deals: Deal[] }.
# Used only when DEAL_DATA_MODE=production or hybrid. Keep API secrets server-side.
DEAL_PRODUCTION_FEED_URLS=
DEAL_PARTNER_FEED_URLS=

# Optional approved official news/event JSON, RSS, or Atom feeds.
# These feeds must follow docs/news-feed-contract.md and return only official finalUrl targets.
# News articles can be source context only; user-visible finalUrl must be an official event, coupon, benefit, or purchase page.
DEAL_NEWS_RSS_URLS=
DEAL_COMMUNITY_RSS_URLS=
DEAL_NEWS_FEED_URLS=
DEAL_EVENT_NEWS_FEED_URLS=
OFFICIAL_EVENT_FEED_URLS=
PUBLIC_COUPON_FEED_URLS=
BENEFIT_REFRESH_FEED_URLS=
# Optional public/education feeds are not part of the default consumer-free-benefit home feed.
# Use only for explicit public/culture/education filters or a separate public-benefit surface.
OPTIONAL_PUBLIC_BENEFIT_FEED_URLS=
BENEFIT_REFRESH_APPROVED_HOSTS=

# Optional approved partner/feed hosts not listed in data/officialSourceCatalog.json.
# Use host names only, never full URLs or tokens. Example: partner-feed.example.com,api.brand.example
HALINDOSA_APPROVED_FEED_HOSTS=
# Local inline data: feeds are disabled by default and must never be enabled in production.
HALINDOSA_ALLOW_DATA_FEED_URLS=false

# Ppomppu/community collection should use an allowed RSS/API/proxy feed, not raw HTML scraping.
PPOMPPU_HOTDEAL_ENABLE=false
PPOMPPU_HOTDEAL_RSS_URL=

# Supabase connection values for the commercial data layer.
# Required to enable real email/social signup/login in /login, /signup, and /mypage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional affiliate/analytics settings.
AFFILIATE_SUB_ID=halindosa-local
# Optional affiliate redirect templates. Replace placeholders after partner approval.
# Supported placeholders: {url}, {encodedUrl}, {dealId}, {mall}, {campaign}, {subId}, {title}
DEFAULT_AFFILIATE_URL_TEMPLATE=
COUPANG_PARTNERS_URL_TEMPLATE=
# Example JSON: {"쿠팡":"https://your-affiliate.example/redirect?url={encodedUrl}&subid={subId}&campaign={campaign}"}
AFFILIATE_URL_TEMPLATES=
TRACKING_SALT=replace-with-random-secret
ADMIN_TOKEN=replace-before-production
ADMIN_EXPORT_TOKEN=replace-before-production
CRON_SECRET=replace-with-random-cron-secret
CRON_REFRESH_TIMEOUT_MS=55000

# Optional push notification sending. Keep disabled until FCM/Web Push consent flow is reviewed.
PUSH_SEND_ENABLED=false
FCM_SERVER_KEY=
FCM_PROJECT_ID=
