# 할인도사 공식 무료혜택 feed 연결 템플릿
# 이 파일은 예시입니다. 실제 운영 값은 Vercel Environment Variables에 입력하세요.
# 공식 HTML 이벤트 페이지를 그대로 넣지 말고 승인된 JSON/RSS/Atom/API endpoint만 넣으세요.

# 1) 파이프라인 canary: 새 feed 연결 전 안전 확인용
BENEFIT_REFRESH_FEED_URLS=https://www.halindosa.com/api/feeds/free-benefits

# 2) 운영 feed: 아래 example URL을 실제 승인 feed endpoint로 교체
# 1. 전체 무료혜택 승인 feed
# 후보: NH농협카드 공식 진행 이벤트, 롯데카드 공식 이벤트, 이니스프리 공식 이벤트·쿠폰 혜택
# 형식: HTTPS JSON/RSS/Atom/API feed endpoint only
BENEFIT_REFRESH_FEED_URLS=
# 예시: BENEFIT_REFRESH_FEED_URLS=https://approved-feed.example/benefit-refresh-feed-urls.json

# 2. 공식 이벤트 feed
# 후보: 이니스프리 공식 이벤트·쿠폰 혜택, CJ ONE 공식 신규가입 축하 쿠폰, KFC 공식 신규 회원 쿠폰 혜택
# 형식: HTTPS JSON/RSS/Atom/API feed endpoint only
OFFICIAL_EVENT_FEED_URLS=
# 예시: OFFICIAL_EVENT_FEED_URLS=https://approved-feed.example/official-event-feed-urls.json

# 3. 쿠폰·멤버십 feed
# 후보: NH농협카드 공식 진행 이벤트, 롯데카드 공식 이벤트, 이니스프리 공식 이벤트·쿠폰 혜택
# 형식: HTTPS JSON/RSS/Atom/API feed endpoint only
PUBLIC_COUPON_FEED_URLS=
# 예시: PUBLIC_COUPON_FEED_URLS=https://approved-feed.example/public-coupon-feed-urls.json

# 4. 뷰티 샘플·무료체험 feed
# 후보: 이니스프리 공식 이벤트·쿠폰 혜택, 마몽드 공식 이벤트·체험 혜택
# 형식: HTTPS JSON/RSS/Atom/API feed endpoint only
BEAUTY_SAMPLE_FEED_URLS=
# 예시: BEAUTY_SAMPLE_FEED_URLS=https://approved-feed.example/beauty-sample-feed-urls.json

# 5. 편의점·마트 feed
# 후보: CU편의점택배 공식 진행 이벤트, CU 공식 1+1·2+1 행사상품, 이마트24 공식 행사상품 혜택
# 형식: HTTPS JSON/RSS/Atom/API feed endpoint only
CONVENIENCE_BENEFIT_FEED_URLS=
# 예시: CONVENIENCE_BENEFIT_FEED_URLS=https://approved-feed.example/convenience-benefit-feed-urls.json

# 6. 페이·포인트·캐시백 feed
# 후보: NH농협카드 공식 진행 이벤트, 롯데카드 공식 이벤트, CJ ONE 공식 득템프 이벤트
# 형식: HTTPS JSON/RSS/Atom/API feed endpoint only
PAY_POINT_BENEFIT_FEED_URLS=
# 예시: PAY_POINT_BENEFIT_FEED_URLS=https://approved-feed.example/pay-point-benefit-feed-urls.json

# 7. 카페·외식 쿠폰 feed
# 후보: 롯데잇츠 공식 이벤트·쿠폰, 도미노피자 공식 이벤트·제휴, 버거킹 공식 진행 이벤트·쿠폰
# 형식: HTTPS JSON/RSS/Atom/API feed endpoint only
CAFE_FRANCHISE_COUPON_FEED_URLS=
# 예시: CAFE_FRANCHISE_COUPON_FEED_URLS=https://approved-feed.example/cafe-franchise-coupon-feed-urls.json

# 8. 통신사 멤버십 feed
# 후보: LG U+ 공식 멤버십 제휴사 혜택, SKT T멤버십 공식 할인·무료 혜택, KT 공식 요고 모바일 가입 혜택
# 형식: HTTPS JSON/RSS/Atom/API feed endpoint only
TELECOM_MEMBERSHIP_FEED_URLS=
# 예시: TELECOM_MEMBERSHIP_FEED_URLS=https://approved-feed.example/telecom-membership-feed-urls.json

# 9. 신규가입 혜택 feed
# 후보: CJ ONE 공식 신규가입 축하 쿠폰, 맘큐 공식 신규회원 웰컴혜택, CU편의점택배 공식 진행 이벤트
# 형식: HTTPS JSON/RSS/Atom/API feed endpoint only
SIGNUP_GIFT_FEED_URLS=
# 예시: SIGNUP_GIFT_FEED_URLS=https://approved-feed.example/signup-gift-feed-urls.json

# 10. 반려동물 샘플 feed
# 후보: 퓨리나 공식 반려동물 이벤트 목록, 네츄럴코어 공식 이벤트 게시판, 하림펫푸드 공식 EVENT 게시판
# 형식: HTTPS JSON/RSS/Atom/API feed endpoint only
PET_SAMPLE_FEED_URLS=
# 예시: PET_SAMPLE_FEED_URLS=https://approved-feed.example/pet-sample-feed-urls.json

# 새 host가 공식 카탈로그에 없을 때만 host 이름을 추가하세요. 토큰/URL 전체를 넣지 마세요.
HALINDOSA_APPROVED_FEED_HOSTS=
BENEFIT_REFRESH_APPROVED_HOSTS=
